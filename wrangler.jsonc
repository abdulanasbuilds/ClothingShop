{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clothingshop",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-23",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/public",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
